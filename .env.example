# Copy this file to .env (or set these as real environment variables /
# systemd Environment= lines) and fill in real values. Nothing here should
# ever be committed with real values — .env is gitignored.

# --- Core ---
PORT=8090
# The public URL this service is reachable at (used to build links in Chat
# messages, the dashboard, and the install script).
PUBLIC_BASE_URL=https://your-domain.example.com

# --- Google Chat ---
# Incoming webhook URL for the space you want usage reports posted to.
# Google Chat > Space settings > Apps & integrations > Manage webhooks.
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/AAAAAAAAAAA/messages?key=YOUR_KEY&token=YOUR_TOKEN

# --- Gmail relay (for the request-access flow) ---
# The mailbox that receives forwarded Claude sign-in emails and relays the
# link back to the requester in Chat.
GMAIL_RELAY_EMAIL=claude-relay@your-domain.example.com
# OAuth client used for both the "authorize the relay mailbox" flow and the
# "set up email forwarding for me" flow. Create at console.cloud.google.com
# under APIs & Services > Credentials > OAuth client ID (Web application).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# --- Access control ---
# Passkey for /admin/* (device-consumption table, roster management,
# account removal). Leave unset to disable admin access entirely (safer
# default than a guessable fallback).
ADMIN_PASSKEY=change-me-to-something-random

# Shared password for /dashboard itself -- a lower-stakes gate the whole
# team knows, separate from ADMIN_PASSKEY. Leave unset to disable (the
# dashboard route will refuse every login attempt).
TEAM_PASSWORD=change-me-too

# --- Accounts (optional alternative to a local accounts.json file) ---
# JSON array of {name, contact, loginEmail} -- lets you configure accounts
# via env instead of a gitignored local file. See src/config/accounts.example.json
# for the shape. Only used if set; otherwise accounts.json is used.
# CLAUDE_ACCOUNTS_JSON=[{"name":"Alice","contact":"@alice","loginEmail":"alice@example.com"}]
